# Create a XGBoost model
t0 = datetime.now()
model3 = XGBClassifier(objective="binary:logistic",eval_metric="mlogloss",random_state=0)
search_spaces = {
    "n_estimators":Integer(100,300),
    "max_depth":Integer(3, 10),    
    "subsample":Real(0.6,1),
    "colsample_bytree":Real(0.5,1),
    "learning_rate":Real(0.01,0.3),
}
opt = BayesSearchCV(
    estimator=model3,
    search_spaces=search_spaces,
    scoring='roc_auc', 
    n_iter=30,
    cv=3,
    n_jobs=-1,
    verbose=1,
    random_state=0,
)
opt.fit(X_train, y_train)
best_model = opt.best_estimator_
t_train_model3 = datetime.now()-t0
print(f"Time required for Bayesian hyperparameter tuning and model training：{t_train_model3.total_seconds()}秒")
print(f"Optimal combination of parameters：{opt.best_params_}")
# Model Performance Evaluation
print(f"The model's accuracy on the training set：{best_model.score(X_train, y_train)}")
